# Demo is the safe default. Set live only on the Node deployment.
STUDIO_MODE=demo
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./var/studio.sqlite
# Required HTTPS origin when NODE_ENV=production and STUDIO_MODE=live.
PUBLIC_URL=
# Comma-separated verified Indian mobile numbers; never shipped to the browser.
ADMIN_PHONES=
# Pending requests reserve staff time until staff confirm/cancel them.
AUTO_CONFIRM=false
# Twilio Verify service and restricted API credentials; never commit actual secrets.
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Optional HTTPS delivery adapter. Events remain queued if this is absent.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
